{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "message",
    "bytes",
    "runtime"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "runtime": {
      "const": "node"
    }
  },
  "additionalProperties": false
}
