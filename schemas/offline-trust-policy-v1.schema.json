{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/offline-trust-policy-v1.schema.json",
  "title": "RepoPassport Offline Trust Policy v1",
  "type": "object",
  "required": ["schemaVersion", "keyAlgorithm", "keyIdAlgorithm", "keys"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "keyAlgorithm": {"const": "ed25519"},
    "keyIdAlgorithm": {"const": "spki-sha256"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "object",
      "required": ["keyId", "status"],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {"enum": ["trusted", "revoked"]}
      },
      "additionalProperties": false
    }
  }
}
