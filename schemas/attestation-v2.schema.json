{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/attestation-v2.schema.json",
  "title": "RepoPassport Repository-Derived in-toto Verification Attestation v2",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"$ref": "#/$defs/subject"}],
      "items": false
    },
    "predicateType": {"const": "https://repopass.dev/attestation/verification/v0.2"},
    "predicate": {"$ref": "#/$defs/predicate"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "rawSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": {"const": "bundle-manifest.json"},
        "digest": {
          "type": "object",
          "required": ["sha256"],
          "properties": {"sha256": {"$ref": "#/$defs/rawSHA256"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": [
        "schemaVersion", "runId", "verificationId", "verificationArtifactDigest",
        "verificationDigest", "source", "plan", "runner", "originalResults", "sbom"
      ],
      "properties": {
        "schemaVersion": {"const": "2"},
        "runId": {"type": "string", "pattern": "^run_[a-zA-Z0-9._-]{3,96}$"},
        "verificationId": {"type": "string", "pattern": "^vrf_[a-zA-Z0-9._-]{3,96}$"},
        "verificationArtifactDigest": {"$ref": "#/$defs/digest"},
        "verificationDigest": {"$ref": "#/$defs/digest"},
        "source": {
          "allOf": [
            {"$ref": "verification.schema.json#/$defs/source"},
            {
              "properties": {
                "identity": {"$ref": "#/$defs/digest"},
                "treeDigest": {"$ref": "#/$defs/digest"}
              },
              "not": {"required": ["commit"]}
            }
          ]
        },
        "plan": {"$ref": "#/$defs/plan"},
        "runner": {"$ref": "verification.schema.json#/$defs/runner"},
        "originalResults": {"$ref": "verification.schema.json#/$defs/results"},
        "sbom": {"$ref": "#/$defs/sbom"}
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "scenario", "environment", "planDigest", "policyBundleDigest",
        "resolvedPlanSchemaVersion", "evidence"
      ],
      "properties": {
        "scenario": {"$ref": "verification.schema.json#/$defs/identifier"},
        "environment": {"$ref": "verification.schema.json#/$defs/identifier"},
        "planDigest": {"$ref": "#/$defs/digest"},
        "policyBundleDigest": {"$ref": "#/$defs/digest"},
        "resolvedPlanSchemaVersion": {"const": "4"},
        "evidence": {
          "allOf": [
            {"$ref": "verification.schema.json#/$defs/evidence"},
            {
              "properties": {
                "profile": {"const": "minimal-public"},
                "include": {"const": ["normalized-observations", "sbom", "verification-summary"]},
                "exclude": {"const": ["raw-stderr", "raw-stdout", "raw-syscall-trace"]}
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "sbom": {
      "type": "object",
      "required": [
        "format", "mediaType", "path", "digest", "provenancePath", "provenanceDigest",
        "privacyProfile", "privacyPolicy", "privacyRulesetDigest"
      ],
      "properties": {
        "format": {"const": "SPDX-2.3"},
        "mediaType": {"const": "application/spdx+json"},
        "path": {"const": "payload/sbom.spdx.json"},
        "digest": {"$ref": "#/$defs/digest"},
        "provenancePath": {"const": "payload/sbom-provenance.json"},
        "provenanceDigest": {"$ref": "#/$defs/digest"},
        "privacyProfile": {"const": "minimal-public-derived-projection-v1"},
        "privacyPolicy": {"const": "minimal-public-derived-projection-v1"},
        "privacyRulesetDigest": {"const": "sha256:2843165f0a7c5ebf01a534b05a0a691ec400054f6667a1d0a177c8f549387db7"}
      },
      "additionalProperties": false
    }
  }
}
