{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/release-authority-transition-chain-v1.schema.json",
  "title": "RepoPassport Release Authority Transition Chain v1",
  "type": "object",
  "required": ["schemaVersion", "product", "channel", "purpose", "hops"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "product": {"const": "repopass"},
    "channel": {"const": "alpha"},
    "purpose": {"const": "release-policy-authority-rotation-chain"},
    "hops": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/hop"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hop": {
      "type": "object",
      "required": ["transitionEnvelope", "nextAuthoritySpkiPem"],
      "properties": {
        "transitionEnvelope": {
          "type": "string",
          "minLength": 4,
          "maxLength": 43692,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "nextAuthoritySpkiPem": {
          "type": "string",
          "minLength": 4,
          "maxLength": 21848,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    }
  }
}
