{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/sbom-provenance-v1.schema.json",
  "title": "RepoPassport npm package-lock Derived SBOM Provenance v1",
  "type": "object",
  "required": [
    "origin", "profile", "rulesetDigest", "sourceProfile",
    "sourceTreeDigest", "inputs", "derivationInputDigest", "scope", "completeness"
  ],
  "properties": {
    "origin": {"const": "repository-derived"},
    "profile": {"const": "npm-package-lock-v1"},
    "rulesetDigest": {"const": "sha256:c73397279cfd48a8a1331a49ceeac90882ae7649b6c279ff0d10830252aceb5e"},
    "sourceProfile": {"const": "local-snapshot-v1"},
    "sourceTreeDigest": {"$ref": "#/$defs/sha256"},
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/packageLockInput"},
        {"$ref": "#/$defs/packageInput"}
      ],
      "items": false
    },
    "derivationInputDigest": {"$ref": "#/$defs/sha256"},
    "scope": {"const": "locked-packages"},
    "completeness": {"const": "lockfile-only"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "input": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1048576}
      },
      "additionalProperties": false
    },
    "packageLockInput": {
      "allOf": [
        {"$ref": "#/$defs/input"},
        {"properties": {"path": {"const": "package-lock.json"}}}
      ]
    },
    "packageInput": {
      "allOf": [
        {"$ref": "#/$defs/input"},
        {"properties": {"path": {"const": "package.json"}}}
      ]
    }
  }
}
