{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/offline-trust-policy-authority-transition-chain-v1.schema.json",
  "title": "RepoPassport Offline Trust Policy Authority Transition Chain v1",
  "type": "object",
  "required": ["schemaVersion", "purpose", "policyPayloadType", "hops"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "purpose": {"const": "offline-trust-policy-authority-rotation-chain"},
    "policyPayloadType": {"const": "application/vnd.repopass.offline-trust-policy.v2+json"},
    "hops": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/hop"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hop": {
      "type": "object",
      "required": ["transitionEnvelope", "nextAuthoritySpkiPem"],
      "properties": {
        "transitionEnvelope": {
          "type": "string",
          "minLength": 4,
          "maxLength": 43692,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "nextAuthoritySpkiPem": {
          "type": "string",
          "minLength": 4,
          "maxLength": 21848,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "additionalProperties": false
    }
  }
}
