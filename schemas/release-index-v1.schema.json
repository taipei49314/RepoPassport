{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/release-index-v1.schema.json",
  "title": "RepoPassport External Release Index v1",
  "type": "object",
  "required": ["artifactType", "channel", "files", "product", "productVersion", "releaseGeneration", "schemaVersion", "trustBoundary"],
  "properties": {
    "artifactType": {"const": "repopass.external-release-index"},
    "channel": {"const": "alpha"},
    "files": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "product": {"const": "repopass"},
    "productVersion": {"const": "0.1.0-alpha.33"},
    "releaseGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "schemaVersion": {"const": "1"},
    "trustBoundary": {"$ref": "#/$defs/trustBoundary"}
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 134217728}
      },
      "allOf": [
        {
          "if": {"properties": {"path": {"const": "SHA256SUMS"}}, "required": ["path"]},
          "then": {"properties": {"size": {"maximum": 65536}}}
        }
      ],
      "additionalProperties": false
    },
    "trustBoundary": {
      "type": "object",
      "required": ["capability", "formalClaim", "identityAttestation", "overall", "timeAttestation"],
      "properties": {
        "capability": {"const": "incomplete"},
        "formalClaim": {"const": false},
        "identityAttestation": {"const": "none"},
        "overall": {"const": "inconclusive"},
        "timeAttestation": {"const": "none"}
      },
      "additionalProperties": false
    }
  }
}
