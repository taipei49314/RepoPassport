        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "response": {
          "$ref": "#/$defs/httpResponseAssertion"
        },
        "fileExists": {
          "$ref": "#/$defs/httpOutputPath"
        },
        "jsonFile": {
          "$ref": "#/$defs/httpJSONFileAssertion"
        }
      },
      "oneOf": [
        {
          "required": [
            "response"
          ]
        },
        {
          "required": [
            "fileExists"
          ]
        },
        {
          "required": [
            "jsonFile"
          ]
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "httpResponseAssertion": {
      "type": "object",
      "required": [
        "requestId"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "header": {
          "type": "object",
          "required": [
            "name",
            "contains"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
            },
            "contains": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "additionalProperties": false
        },
        "bodyContains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "jsonPath": {
          "type": "object",
          "required": [
            "path",
            "equals"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^\\$"
            },
            "equals": {}
          },
          "additionalProperties": false
        },
        "jsonSchema": {
          "$ref": "#/$defs/repositoryPath"
        }
      },
      "minProperties": 2,
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
