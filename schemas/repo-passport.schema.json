{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/repo-passport.schema.json",
  "title": "RepoPassport Manifest",
  "description": "Strict authoring contract for repo-passport.yml after YAML is decoded to JSON.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "repopass.dev/v1alpha1"
    },
    "kind": {
      "const": "RepositoryPassport"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9.-]*$": {}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "environmentVariableName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:ms|s|m|h)$"
    },
    "positiveMillisecondDuration": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:ms|s|m|h)|(?:0|[1-9][0-9]*)\\.[0-9]{1,3}s)$",
      "not": {
        "pattern": "^0\\.0{1,3}s$"
      }
    },
    "httpReadinessDuration": {
      "type": "string",
      "pattern": "^(?:(?:[1-9][0-9]{0,4}|1[01][0-9]{4}|120000)ms|(?:[1-9]|[1-9][0-9]|1[01][0-9]|120)s|[12]m|(?:[0-9]|[1-9][0-9]|1[01][0-9])\\.[0-9]{1,3}s)$",
      "not": {
        "pattern": "^0\\.0{1,3}s$"
      }
    },
    "httpURL": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@/-]|%[0-9A-Fa-f]{2})*)?(?:\\?(?:[A-Za-z0-9._~!$&'()*+,;=:@/?-]|%[0-9A-Fa-f]{2})+)?$",
      "allOf": [
        {
          "not": {
            "pattern": "[#\\\\]"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:\\.|%2[eE])(?:\\.|%2[eE])?(?:/|\\?|$)"
          }
        }
      ]
    },
    "httpOutputPath": {
      "type": "string",
      "minLength": 8,
      "maxLength": 4096,
      "pattern": "^/outputs(?:/[^\\\\]+)*$",
      "not": {
        "pattern": "(?:^|/)\\.\\.(?:/|$)"
      }
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:KiB|MiB|GiB|TiB)$"
    },
    "sandboxPath": {
      "type": "string",
      "pattern": "^/[^\\\\]*$",
      "not": {
        "pattern": "(?:^|/)\\.\\.(?:/|$)"
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[ -~]+$",
      "allOf": [
        {
          "not": {
            "pattern": "^/"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "\\\\"
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "maintainers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maintainer"
          },
          "uniqueItems": true
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "maintainer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "project",
        "environments",
        "scenarios",
        "policies",
        "evidence"
      ],
      "properties": {
        "project": {
          "$ref": "#/$defs/project"
        },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environment"
          }
        },
        "scenarios": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scenario"
          }
        },
        "policies": {
          "$ref": "#/$defs/policies"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "kind",
        "audiences",
        "entrypoints"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cli",
            "web-app",
            "api",
            "library",
            "notebook",
            "model",
            "dataset",
            "documentation",
            "desktop-app",
            "mobile-app",
            "unknown"
          ]
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "end-user",
              "student",
              "developer",
              "maintainer",
              "security",
              "automation"
            ]
          }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "runtime",
        "baseImage",
        "resources"
      ],
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "baseImage": {
          "$ref": "#/$defs/baseImage"
        },
        "resources": {
          "$ref": "#/$defs/resourceLimits"
        },
        "requiredServices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "requiredRunnerFeatures": {
          "$ref": "#/$defs/runnerFeatures"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "adapter",
        "version"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "node",
            "python"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "baseImage": {
      "type": "object",
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "resourceLimits": {
      "type": "object",
      "required": [
        "cpu",
        "memory",
        "disk",
        "pids"
      ],
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory": {
          "$ref": "#/$defs/size"
        },
        "disk": {
          "$ref": "#/$defs/size"
        },
        "pids": {
          "type": "integer",
          "minimum": 1
        },
        "time": {
          "$ref": "#/$defs/duration"
        },
        "logBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "runnerFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "network-deny",
          "setup-egress-allowlist",
          "process-exec-observation",
          "filesystem-write-observation",
          "port-listen-observation",
          "resource-usage-observation",
          "process-tree-cleanup"
        ]
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "environment",
        "phases",
        "verification"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "audience": {
          "enum": [
            "end-user",
            "student",
            "developer",
            "maintainer",
            "security",
            "automation"
          ]
        },
        "environment": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "phases": {
          "$ref": "#/$defs/phases"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilitiesByPhase"
        },
        "secrets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/secret"
          }
        },
        "verification": {
          "$ref": "#/$defs/verificationSettings"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "file",
            "directory",
            "json",
            "secret-reference",
            "choice"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "fixture": {
          "$ref": "#/$defs/repositoryPath"
        },
        "mount": {
          "$ref": "#/$defs/inputMount"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "file",
                  "directory"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "mount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret-reference"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "fixture"
                  ]
                },
                {
                  "required": [
                    "mount"
                  ]
                },
                {
                  "required": [
                    "choices"
                  ]
                }
              ]
            }
          }
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "inputMount": {
      "type": "object",
      "required": [
        "path",
        "readOnly"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/sandboxPath"
        },
        "readOnly": {
          "const": true
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "exercise"
      ],
      "properties": {
        "prepare": {
          "$ref": "#/$defs/stepPhase"
        },
        "setup": {
          "$ref": "#/$defs/stepPhase"
        },
        "build": {
          "$ref": "#/$defs/stepPhase"
        },
        "run": {
          "$ref": "#/$defs/runPhase"
        },
        "exercise": {
          "$ref": "#/$defs/exercisePhase"
        },
        "cleanup": {
          "$ref": "#/$defs/stepPhase"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "stepPhase": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "observerRequirements": {
          "$ref": "#/$defs/observerRequirements"
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sandboxPath"
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "runPhase": {
      "type": "object",
      "properties": {
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "observerRequirements": {
          "$ref": "#/$defs/observerRequirements"
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sandboxPath"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "steps"
          ]
        },
        {
          "required": [
            "service"
          ]
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "exercisePhase": {
      "type": "object",
      "required": [
        "driver"
      ],
      "properties": {
        "timeout": {
          "type": "string"
        },
        "driver": {
          "oneOf": [
            {
              "$ref": "#/$defs/cliDriver"
            },
            {
              "$ref": "#/$defs/httpDriver"
            }
          ]
        },
        "observerRequirements": {
          "$ref": "#/$defs/observerRequirements"
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sandboxPath"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "driver": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "http"
                  }
                }
              }
            },
            "required": [
              "driver"
            ]
          },
          "then": {
            "properties": {
              "timeout": {
                "$ref": "#/$defs/positiveMillisecondDuration"
              }
            }
          },
          "else": {
            "properties": {
              "timeout": {
                "$ref": "#/$defs/duration"
              }
            }
          }
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "run": {
          "$ref": "#/$defs/commandSpec"
        },
        "signal": {
          "$ref": "#/$defs/signalSpec"
        }
      },
      "oneOf": [
        {
          "required": [
            "run"
          ]
        },
        {
          "required": [
            "signal"
          ]
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commandSpec": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/argv"
        },
        "shell": {
          "$ref": "#/$defs/shellCommand"
        },
        "workingDirectory": {
          "$ref": "#/$defs/sandboxPath"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/environmentVariableName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environmentReference"
          }
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "allowedExitCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "outputMode": {
          "enum": [
            "text",
            "json",
            "binary",
            "discard"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "shell"
          ]
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "shellCommand": {
      "type": "object",
      "required": [
        "executable",
        "command"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/sandboxPath"
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "environmentReference": {
      "type": "object",
      "required": [
        "source",
        "name"
      ],
      "properties": {
        "source": {
          "enum": [
            "input",
            "secret"
          ]
        },
        "name": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "signalSpec": {
      "type": "object",
      "required": [
        "target",
        "type",
        "gracePeriod"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "term",
            "kill",
            "int",
            "hup"
          ]
        },
        "gracePeriod": {
          "$ref": "#/$defs/positiveMillisecondDuration"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "readiness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "$ref": "#/$defs/argv"
        },
        "shell": {
          "$ref": "#/$defs/shellCommand"
        },
        "workingDirectory": {
          "$ref": "#/$defs/sandboxPath"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/environmentVariableName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environmentReference"
          }
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "shell"
          ]
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "http"
      ],
      "properties": {
        "http": {
