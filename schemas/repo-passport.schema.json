      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "profile",
        "include",
        "exclude"
      ],
      "properties": {
        "profile": {
          "enum": [
            "minimal-public",
            "local-full"
          ]
        },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "verification-summary",
              "normalized-observations",
              "sbom"
