              }
            }
          },
          "patternProperties": {
            "^x-[a-z0-9][a-z0-9.-]*$": {}
          },
          "additionalProperties": false
        },
        "exposeAs": {
          "type": "object",
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "$ref": "#/$defs/environmentVariableName"
            }
          },
          "patternProperties": {
            "^x-[a-z0-9][a-z0-9.-]*$": {}
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
