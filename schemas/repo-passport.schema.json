        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "raw-stdout",
              "raw-stderr",
              "raw-syscall-trace"
            ]
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    }
  }
