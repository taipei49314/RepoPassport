            "$ref": "#/$defs/environmentVariableName"
          }
        },
        "write": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environmentVariableName"
          }
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
