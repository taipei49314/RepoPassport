      "type": "object",
      "required": [
        "repeats",
        "successThreshold",
        "requiredObservers",
        "cleanup"
      ],
      "properties": {
        "repeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "requiredObservers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observerName"
          }
        },
