        "id": {
          "$ref": "#/$defs/identifier"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdoutContains": {
          "type": "string"
        },
        "stdoutRegex": {
          "type": "string"
        },
        "stdoutJsonSchema": {
          "$ref": "#/$defs/repositoryPath"
        },
        "stderrContains": {
          "type": "string"
        },
        "stderrRegex": {
          "type": "string"
        },
        "fileExists": {
          "$ref": "#/$defs/sandboxPath"
        },
        "jsonFile": {
          "$ref": "#/$defs/jsonFileAssertion"
        }
      },
      "oneOf": [
        {
          "required": [
            "exitCode"
          ]
        },
        {
          "required": [
            "stdoutContains"
          ]
        },
        {
          "required": [
            "stdoutRegex"
          ]
        },
        {
          "required": [
            "stdoutJsonSchema"
          ]
        },
        {
          "required": [
            "stderrContains"
          ]
        },
        {
          "required": [
            "stderrRegex"
          ]
        },
        {
          "required": [
            "fileExists"
          ]
        },
        {
          "required": [
            "jsonFile"
          ]
        }
      ],
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "httpDriver": {
      "type": "object",
      "required": [
        "type",
        "steps"
      ],
      "properties": {
        "type": {
          "const": "http"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "contains": {
            "$ref": "#/$defs/httpRequestStep"
          },
          "minContains": 1,
          "maxContains": 32,
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/httpAssertionStep"
              },
              "minContains": 1
            }
          ],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/httpRequestStep"
              },
              {
                "$ref": "#/$defs/httpAssertionStep"
              }
            ]
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "httpRequestStep": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/httpRequest"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "httpRequest": {
      "type": "object",
      "required": [
        "id",
        "method",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "method": {
          "enum": [
            "get",
            "head",
            "post",
            "put",
            "patch",
            "delete",
            "options"
          ]
        },
        "url": {
          "$ref": "#/$defs/httpURL"
        },
        "headers": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[ -~]*$",
            "maxLength": 8192
          }
        },
        "json": {},
        "body": {
          "type": "string",
          "maxLength": 1048576
        },
        "timeout": {
          "$ref": "#/$defs/positiveMillisecondDuration"
        }
      },
      "not": {
        "required": [
          "json",
          "body"
        ]
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "httpAssertionStep": {
      "type": "object",
      "required": [
        "assert"
      ],
      "properties": {
        "assert": {
          "$ref": "#/$defs/httpAssertion"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
      "additionalProperties": false
    },
    "httpAssertion": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
