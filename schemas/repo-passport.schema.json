              "$ref": "#/$defs/pathSet"
            }
          },
          "patternProperties": {
            "^x-[a-z0-9][a-z0-9.-]*$": {}
          },
          "additionalProperties": false
        },
        "stabilityRule": {
          "enum": [
            "all-matching",
            "threshold-matching"
          ],
          "default": "all-matching"
        },
        "resourceVariancePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9.-]*$": {}
      },
