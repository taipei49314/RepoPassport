{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/observation.schema.json",
  "title": "RepoPassport Observation Event",
  "description": "Strict public schema for one normalized trusted-runner observation.",
  "$ref": "#/$defs/observationEvent",
  "$defs": {
    "observationEvent": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sequence",
        "timestamp",
        "phase",
        "actor",
        "operation",
        "resource",
        "result",
        "observer",
        "coverage",
        "confidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "phase": {
          "enum": [
            "prepare",
            "setup",
            "build",
            "run",
            "exercise",
            "cleanup"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$",
          "maxLength": 128
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "result": {
          "enum": [
            "allowed",
            "denied",
            "succeeded",
            "failed",
            "observed",
            "unavailable",
            "unknown"
          ]
        },
        "observer": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "maxLength": 128
        },
        "coverage": {
          "enum": [
            "full",
            "high",
            "best-effort",
            "enforcement-only",
            "unavailable"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "details": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "array"
            ],
            "maxItems": 16,
            "items": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
