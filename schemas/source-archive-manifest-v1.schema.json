{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repopass.dev/v1alpha1/source-archive-manifest-v1.schema.json",
  "title": "RepoPassport source archive manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archive",
    "artifactType",
    "files",
    "schemaVersion",
    "subject"
  ],
  "properties": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "name", "sha256", "size"],
      "properties": {
        "format": {"const": "ustar-v1"},
        "name": {"const": "repopass-source.tar"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 2048, "maximum": 536870912, "multipleOf": 512}
      }
    },
    "artifactType": {"const": "repopass-source-archive-manifest"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "items": {"$ref": "#/$defs/file"},
      "contains": {
        "properties": {
          "gitMode": {"const": "100644"},
          "path": {"const": "go.mod"}
        },
        "required": ["gitMode", "path"]
      },
      "minContains": 1,
      "maxContains": 1,
      "not": {
        "contains": {
          "properties": {"path": {"const": "go.work"}},
          "required": ["path"]
        }
      }
    },
    "schemaVersion": {"const": "1"},
    "subject": {"$ref": "#/$defs/subject"}
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[ -~]+$",
      "anyOf": [
        {"maxLength": 100},
        {"minLength": 101, "pattern": "^[ -~]{1,155}/[^/]{1,100}$"}
      ],
      "allOf": [
        {"not": {"pattern": "^/|/$|//"}},
        {"not": {"pattern": "[\\\\:*?\"<>|]"}},
        {"not": {"pattern": "(^|/)[.]{1,2}(/|$)"}},
        {"not": {"pattern": "[. ](/|$)"}},
        {"not": {"pattern": "(^|/)([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])([.][^/]*)?(/|$)"}}
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseRevision",
        "dirty",
        "gitObjectFormat",
        "modulePath",
        "moduleVersion",
        "repository",
        "testedRevision",
        "treeSHA"
      ],
      "properties": {
        "baseRevision": {"$ref": "#/$defs/sha1"},
        "dirty": {"const": false},
        "gitObjectFormat": {"const": "sha1"},
        "modulePath": {"const": "github.com/taipei49314/RepoPassport"},
        "moduleVersion": {"const": "0.1.0-alpha.33"},
        "repository": {"const": "https://github.com/taipei49314/RepoPassport"},
        "testedRevision": {"$ref": "#/$defs/sha1"},
        "treeSHA": {"$ref": "#/$defs/sha1"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitBlobSHA1", "gitMode", "path", "sha256", "size"],
      "properties": {
        "gitBlobSHA1": {"$ref": "#/$defs/sha1"},
        "gitMode": {"enum": ["100644", "100755"]},
        "path": {"$ref": "#/$defs/portablePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0, "maximum": 134217728}
      }
    }
  }
}
